# Backend WebSocket URL (your Render backend)
BACKEND_URL=https://your-backend.onrender.com

# API Key for WebSocket connection (generate from Printer Settings in the ERP)
WS_API_KEY=your_api_key_here

# Branch ID this printer belongs to
BRANCH_ID=your_branch_id_here

# Printer settings
PRINTER_IP=192.168.100.100
PRINTER_PORT=9100

# Restaurant name on receipts
RESTAURANT_NAME=MY RESTAURANT

# Print filter: only print orders matching this type (leave empty to print all)
# Options: KDS, DineIn, TakeAway, Delivery  (comma-separated for multiple)
PRINT_ORDER_TYPES=

# Receipt width in characters (32 for 58mm, 48 for 80mm paper)
RECEIPT_WIDTH=32
